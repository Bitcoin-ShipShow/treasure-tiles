{
  "name": "treasure-tiles",
  "version": "0.1.0",
  "description": "Treasure Tiles: a pirate phrase-guessing race for the Bitcoin Shipshow, played over Nostr",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && tsx src/server/index.ts",
    "demo": "node build.mjs && DEMO=1 tsx src/server/index.ts",
    "dev": "node build.mjs --watch & tsx watch src/server/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "node build.mjs && tsx test/ui-shots.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@getalby/sdk": "^8.1.1",
    "express": "^5.3.0",
    "nostr-tools": "^2.25.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
